{
  "name": "patch-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Patch SDK monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:react": "cd packages/react && bun run build",
    "publish:react": "npm publish --workspace=@patch-sdk/react --access public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}